{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "工作空间目录结构与交付链路",
    "subtitle": "一个任务目录 = 客户的一个需求批次，任务内固定 scripts/ 与 results/",
    "output": "workspace-structure.html"
  },
  "components": [
    {
      "id": "prod",
      "type": "external",
      "label": "生产标准分析目录",
