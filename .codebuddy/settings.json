{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CODEBUDDY_PROJECT_DIR/.codebuddy/hooks/check_inbox.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CODEBUDDY_PROJECT_DIR/.codebuddy/hooks/suggest_title.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_to_file|edit_file|replace_in_file|execute_command|execute_bash|bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .ws/bin/ws_guard_hook.py pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
